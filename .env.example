# Username for the single shared login
ADMIN_USERNAME=admin
# Password for the single shared login (change before deploying)
ADMIN_PASSWORD=change-this-password
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bearer session lifetime in seconds (default: 8 hours)
SESSION_TTL_SECONDS=28800
# Uploaded workbook retention in seconds (default: 30 minutes)
UPLOAD_TTL_SECONDS=1800
# Optional absolute API base URL for the built frontend (defaults to /api on the same origin)
VITE_API_BASE_URL=
